  <property name="styleSheet">
   <string notr="true">/* 主窗口背景 */
QMainWindow {
    background-color: #f0f0f0; /* 浅灰色背景 */
}

/* 所有按钮的通用样式 */
QPushButton {
    background-color: #e0e0e0; /* 按钮背景色 */
    color: #333; /* 按钮文字颜色 */
    font-size: 16px; /* 字体大小 */
    border: 1px solid #ccc; /* 按钮边框 */
    border-radius: 4px; /* 圆角 */
    padding: 10px; /* 内边距 */
}

/* 运算符按钮（+、-、×、÷、= 等）的特殊样式 */
QPushButton[objectName^=&quot;btnPlus&quot;], 
QPushButton[objectName^=&quot;btnMinus&quot;], 
QPushButton[objectName^=&quot;btnMultiple&quot;], 
QPushButton[objectName^=&quot;btnDivide&quot;], 
QPushButton[objectName=&quot;btnEqual&quot;] {
    background-color: #ff9500; /* 橙色，突出运算符 */
    color: white; /* 白色文字 */
}

/* 功能按钮（CE、C、%、1/x 等）的特殊样式 */
QPushButton[objectName^=&quot;btnClear&quot;], 
QPushButton[objectName=&quot;btnClearall&quot;], 
QPushButton[objectName=&quot;btnPercentage&quot;], 
QPushButton[objectName=&quot;btnSqrt&quot;] ,
QPushButton[objectName=&quot;btnSquare&quot;],
QPushButton[objectName=&quot;btnInverse&quot;]{
    background-color: #ff5555; /* 红色，突出功能键 */
    color: white;
}

/* 按钮 hover（鼠标悬浮）效果 */
QPushButton:hover {
    background-color: #d0d0d0; /*  hover 时变浅 */
}

QPushButton[objectName^=&quot;btnPlus&quot;]:hover, 
QPushButton[objectName^=&quot;btnMinus&quot;]:hover, 
QPushButton[objectName^=&quot;btnMultiple&quot;]:hover, 
QPushButton[objectName^=&quot;btnDivide&quot;]:hover, 
QPushButton[objectName=&quot;btnEqual&quot;]:hover {
    background-color: #ffad33; /* 运算符 hover 时变浅 */
}

QPushButton[objectName^=&quot;btnClear&quot;]:hover, 
QPushButton[objectName=&quot;btnClearall&quot;]:hover, 
QPushButton[objectName=&quot;btnPercentage&quot;]:hover, 
QPushButton[objectName=&quot;btnInverse&quot;]:hover,
QPushButton[objectName=&quot;btnSqrt&quot;]:hover ,
QPushButton[objectName=&quot;btnSquare&quot;]:hover {
    background-color: #ff7777; /* 功能键 hover 时变浅 */
}

QLineEdit#display {
    background-color: #ffffff; /* 白色背景 */
    color: #222222; /* 深色文字，更清晰 */
    font-size: 24px; /* 字号更大，突出结果 */
    font-weight: bold; /* 加粗文字 */
    border: 2px solid #cccccc; /* 边框稍粗 */
    border-radius: 6px; /* 圆角 */
    padding: 10px 15px; /* 上下内边距10px，左右15px，避免文字贴边 */
    text-align: right; /* 文字右对齐（计算器常规样式） */
    margin: 5px; /* 与周围控件保持距离 */
}</string>
